{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["comun/**/*.ts", "firestore/**/*.ts", "functions/src/**/*.ts", "functions/pruebas/**/*.ts", "reglas/**/*.ts", "scripts/**/*.ts"]
}
